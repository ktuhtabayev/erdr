# Text files use LF in the repository and in the working tree on every platform,
# so a checkout never rewrites line endings.
* text=auto eol=lf

# Windows scripts keep CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Protected source material (CLAUDE.md: never modify) is stored byte for byte
resources/** -text
# The datasets are stored byte for byte: their checksums must not depend on the platform
# (the .csv files use CRLF, the .dat files LF — exactly as in the template project)
datasets/** -text
src/erdr/data/datasets/** -text
tests/data/** -text

# Experiment workbooks, documents and images are binary (no Git LFS)
*.xlsx binary
*.xls  binary
*.docx binary
*.doc  binary
*.pdf  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
